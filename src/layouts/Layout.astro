---
import "@styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Unísono — Generador Dinámico de Calendarios",
	description = "Aplicación web para automatizar y estandarizar la creación de cronogramas trimestrales de equipos y servicios eclesiásticos. Facilita a los administradores el cálculo dinámico de fechas y la asignación de personal a eventos cíclicos a través de una interfaz minimalista. Su principal utilidad es optimizar la organización institucional y eliminar el trabajo manual, permitiendo exportar los calendarios generados directamente a documentos PDF.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/app-icon.svg" />
		<meta name="theme-color" content="#1e293b" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
